# synt account service. Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://akun_rw:change-me@127.0.0.1/synt_akun
# Origins allowed to sign in and change data (comma-separated, no trailing slash)
AKUN_ORIGINS=https://localhost:8443
AKUN_BIND=127.0.0.1
AKUN_PORT=5681
# Solana mainnet RPC (HTTPS). Leave empty to turn Solana trading off.
AKUN_RPC_URL=
# Optional
# AKUN_JUP_API_KEY=
# AKUN_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# AKUN_DASH_URL=https://preview.synt.fun
# AKUN_CLOUDFLARE=1
RUST_LOG=synt_akun=info
