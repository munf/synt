# Copy to .env and fill in. Never commit .env.

# PostgreSQL 14 or newer. The schema is created on first start.
DATABASE_URL=postgres://recorder:change-me@127.0.0.1:5432/launchpads

# BNB Chain RPC, WebSocket (eth_subscribe logs) and HTTP (eth_getLogs,
# eth_call, receipts). The public endpoints below work for a trial run; for
# continuous recording use a provider with an archive-capable, non-lagging
# node and check its request quota against the numbers in README.md.
BSC_WSS_URL=wss://bsc-rpc.publicnode.com
BSC_HTTP_URL=https://bsc-rpc.publicnode.com

# Optional. Defaults shown.
# Max HTTP requests per second for the recorder and the price writers.
#BSC_RPS=10
# Max requests per second for the tx.from backfill (separate throttle).
#BSC_RPS_SENDER=25
# Blocks per eth_getLogs when filling a gap after a reconnect.
#BACKFILL_CHUNK_BLOCKS=500
# Log level: error, warn, info, debug.
#RUST_LOG=info,sqlx=warn
